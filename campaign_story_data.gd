static func dialogue(stage: String, recruit: String, won: bool) -> Array:
	var result: Array = SCENES[stage][1 if won else 0].duplicate(true)
	if not won and stage in ["fifth_drum","old_bridge"]:
		var line := ["強盜","東邊戰亂加上重稅，把人逼上了逃荒的路。\n可他們還穿著民兵衣服，就已經跟強盜一起搶糧了。","bandit","lord"] if recruit == "bandit" else ["騎士","東邊的軍餉斷了，領主還在加稅。\n但叛逃搶糧就是叛逃搶糧，我不替他們辯護。","knight","lord"]
		if recruit in ["bandit","knight"]: result.insert(result.size()-1,line)
	return result
